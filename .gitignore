# Dependencies
node_modules/

# Build outputs
# NOTE: dist/ is intentionally committed so the extension can be loaded directly
# from a GitHub download (Load unpacked) without requiring a local `npm run build`.
# The manifest's content_scripts reference dist/content.bundle.js.
# dist/

# macOS
.DS_Store
**/.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Debug
debug/

# Package manager locks (optional - uncomment if you want to ignore)
# package-lock.json
# yarn.lock

# Chrome extension dev files
*.crx
*.pem

# Test coverage
coverage/

# Server (private - NEVER push to GitHub)
server/

# Temporary files
*.tmp
*.temp
.cache/

# Audit / internal reports (keep local, do not publish)
CODE_CLEANUP_REPORT.md
NEXT_LEVEL_IMPROVEMENTS.md
PERFORMANCE_AUDIT_REPORT.md
SECURITY_AUDIT_REPORT.md

